# Installation-specific state
REGISTRY.md
vault
_workspace/
.ua
.understand-anything/

# Public docs build output and local dependencies. Pages receives dist as an
# Actions artifact; neither generated HTML nor node_modules belongs in Git.
docs-site/dist/
docs-site/node_modules/

# Third-party checkouts placed by install-phase2b-tools.sh. Ignore the
# contents rather than the directory itself, so the tracked pin ledger inside
# it stays visible to git.
.tools/*
!.tools/PINS.md

# Telegram bridge runtime state. Holds chat IDs and per-chat selections, so it
# is installation-specific and must never be committed.
examples/telegram_bot/bot_state.json
examples/telegram_bot/bot.log
examples/telegram_bot/.venv/

# Feed scraper runtime state. `sources.local.toml` is this machine's choice of
# sources and `.env` holds the API key, so neither belongs in the harness.
examples/feed_scraper/sources.local.toml
examples/feed_scraper/.env
examples/feed_scraper/.venv/
examples/feed_scraper/scraper.log*
examples/feed_scraper/data/

# Local/editor state
.DS_Store
*.swp
*.swo
__pycache__/
*.pyc
